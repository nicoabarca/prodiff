  "groups": [
    {
      "name": "Cobranza",
      "filters": [
        {
          "kind": "attribute",
          "column": "Actividad",
          "mode": "mandatory",
          "values": ["Enviar a cobranza"]
        }
      ]
    },
    {
      "name": "Pagadas",
      "filters": [
        {
          "kind": "attribute",
          "column": "Actividad",
          "mode": "mandatory",
          "values": ["Pago"]
        }
      ]
    },
    {
      "name": "Control en terreno",
      "filters": [
        {
          "kind": "attribute",
          "column": "Canal de detección",
          "mode": "mandatory",
          "values": ["Control en terreno"]
        }
      ]
    },
    {
      "name": "Cámara de tránsito",
      "filters": [
        {
          "kind": "attribute",
          "column": "Canal de detección",
          "mode": "mandatory",
          "values": ["Cámara de tránsito"]
        }
      ]
    },
    {
      "name": "Pago en línea",
      "filters": [
        {
          "kind": "attribute",
          "column": "Medio de pago",
          "mode": "mandatory",
          "values": ["En línea"]
        }
      ]
    },
    {
      "name": "Pago en banco u oficina",
      "filters": [
        {
          "kind": "attribute",
          "column": "Medio de pago",
          "mode": "mandatory",
          "values": ["Banco", "Oficina municipal"]
