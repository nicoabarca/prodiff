      "role": "case_id",
      "scope": "case",
      "caseResolution": "constant",
      "type": "string"
    },
    {
      "name": "Actividad",
      "role": "activity_name",
      "scope": "event",
      "type": "string"
    },
    {
      "name": "Fecha",
      "role": "complete_timestamp",
      "scope": "event",
