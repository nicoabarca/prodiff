      "role": "other",
      "scope": "case",
      "caseResolution": "constant",
      "type": "string"
    },
    {
      "name": "Total pagado",
      "role": "other",
      "scope": "case",
      "caseResolution": "constant",
      "type": "float"
    },
    {
      "name": "Gastos de envío",
      "role": "other",
      "scope": "event",
      "type": "float"
    },
    {
      "name": "Monto con recargo",
      "role": "other",
      "scope": "event",
      "type": "float"
