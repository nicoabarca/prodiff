{"nodes": [{"id": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_decision", "label": "ADR 0002: Persist Parsed Parquet, Keep Raw Original", "file_type": "rationale", "source_file": "docs/adr/0002-persist-parsed-parquet-keep-raw-original.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mapped log is written once as typed Parquet at {app_data}/projects/{id}/event_log.parquet and is the working copy. Re-parsing on every cold load was rejected as repeated cost for no benefit; deleting the raw upload was rejected because it forecloses re-running column mapping and removes a fallback against a future conversion bug."}, {"id": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_hidden_column_flag", "label": "Hidden Columns Enforced by Query-Time Metadata Flag", "file_type": "concept", "source_file": "docs/adr/0002-persist-parsed-parquet-keep-raw-original.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hidden columns stay in the Parquet file and are filtered by a metadata flag read at query time, so un-hiding never requires re-parsing."}], "edges": [{"source": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_decision", "target": "context_event_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-persist-parsed-parquet-keep-raw-original.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_decision", "target": "context_column_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-persist-parsed-parquet-keep-raw-original.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_decision", "target": "docs_adr_0002_persist_parsed_parquet_keep_raw_original_hidden_column_flag", 