{"nodes": [{"id": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "label": "ADR 0004: Domain-Oriented Frontend Architecture", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reorganized src/lib from by-kind to by-domain because reading one feature meant opening five directories and components/projects/ had grown to 35 files covering every feature. Each domain maps to a module under src-tauri/src/ and four map to a route, so a URL names the directory that serves it."}, {"id": "docs_adr_0004_domain_oriented_frontend_architecture_schema_exception", "label": "db/schema.ts Stays One File", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate exception to domain ownership: seeing every table in one place beats strict ownership, so schema.ts imports persisted types from four domains."}, {"id": "docs_adr_0004_domain_oriented_frontend_architecture_statistics_exception", "label": "statistics/ Stays Its Own Domain", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns no state and no types and takes every input from slices/, but keeping directories mapped one-to-one to routes makes navigation predictable."}, {"id": "docs_adr_0004_domain_oriented_frontend_architecture_event_log_one_domain", "label": "Project and Event Log Are One Domain", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project.columns is ColumnMapping[] and createProject calls addProject, so splitting them would create bidirectional references; event_log/commands.rs already treats them as one module."}, {"id": "docs_adr_0004_domain_oriented_frontend_architecture_e2e_blocked", "label": "End-to-End Tests Blocked on macOS", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tauri-driver supports Linux and Windows only, so Playwright cannot drive the real Tauri window on macOS, and browser testing would mean mocking invoke() and plugin-sql wholesale. Blocked rather than deferred."}, {"id": "docs_adr_0004_domain_oriented_frontend_architecture_deferred_cleanups", "label": "Deferred Filter Editor Split and Fat Route Thinning", "file_type": "rationale", "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting filter-editor.svelte (833 lines, ~18 shared $state variables) into per-kind editors and thinning the four fat routes are rewrites rather than moves, so they belong in their own reviews."}], "edges": [{"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "claude_one_way_dependency_rule", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "docs_adr_0004_domain_oriented_frontend_architecture_schema_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "docs_adr_0004_domain_oriented_frontend_architecture_statistics_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "docs_adr_0004_domain_oriented_frontend_architecture_event_log_one_domain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_event_log_one_domain", "target": "context_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_event_log_one_domain", "target": "context_event_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_event_log_one_domain", "target": "context_column_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "claude_invoker_pattern", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-domain-oriented-frontend-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_domain_oriented_frontend_architecture_decision", "target": "claude_no_b