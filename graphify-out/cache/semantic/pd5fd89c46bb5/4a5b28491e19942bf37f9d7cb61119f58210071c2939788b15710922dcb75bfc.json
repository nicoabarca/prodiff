{"nodes": [{"id": "docs_adr_0003_query_distributions_on_demand_decision", "label": "ADR 0003: Query Distributions On Demand", "file_type": "rationale", "source_file": "docs/adr/0003-query-distributions-on-demand.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distributions are fetched per selected node by node_distributions rather than shipped with directed_tree, because they are offered for every non-hidden column under two Scopes; build-time computation would multiply the most expensive operation by column count and Scope to produce numbers read one node at a time."}, {"id": "docs_adr_0003_query_distributions_on_demand_directed_tree", "label": "directed_tree Single-Payload Build", "file_type": "concept", "source_file": "docs/adr/0003-query-distributions-on-demand.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships every Node Aggregate, Significance Test and Co-movement pair in one payload precisely so the frontend never re-aggregates. Distributions are the deliberate exception."}, {"id": "docs_adr_0003_query_distributions_on_demand_node_distributions", "label": "node_distributions Command", "file_type": "concept", "source_file": "docs/adr/0003-query-distributions-on-demand.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed on the node's leaf Variant keys and its depth rather than an activity prefix, so node identity is never re-derived from labels on either side. The drawer refuses to fetch while the tree is stale because those keys come from the tree on screen."}], "edges": [{"source": "docs_adr_0003_query_distributions_on_demand_decision", "target": "docs_adr_0003_query_distributions_on_demand_directed_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0003-query-distributions-on-d